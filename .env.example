# ODPT_API_KEY: Consumer key for ODPT (Public Transportation Open Data Center) API v4.
# Configure your key in the AI Studio Secrets panel (or GitHub Secrets for CI) to
# enable live train operation status, train location polling, and station timetables on ODPT railways.
ODPT_API_KEY=ODPT_API_KEY_UNCONFIGURED

# EKISPERT_API_KEY: Access key for Ekispert Web Service API (https://docs.ekispert.com/).
# Enables nationwide route search, station lookup, and station timetables when configured.
EKISPERT_API_KEY=EKISPERT_API_KEY_UNCONFIGURED

# MIXWAY_API_KEY: Access key for Val Laboratory mixway API (https://docs-mixway.ekispert.jp/).
# Enables tripCode-based realtime train/bus delay and vehicle status when contracted with operators.
MIXWAY_API_KEY=MIXWAY_API_KEY_UNCONFIGURED

# JORUDAN_API_KEY: Access key for Jorudan Norikae Open API / Biz API.
JORUDAN_API_KEY=JORUDAN_API_KEY_UNCONFIGURED

# NAVITIME_API_KEY: Access key / RapidAPI key for NAVITIME API 2.0.
NAVITIME_API_KEY=NAVITIME_API_KEY_UNCONFIGURED

# JR_TRAINFORMATION_PROXY_URL: Optional authorized proxy/gateway base URL (https://...) for
# JR West / JR Central / JR Hokkaido feeds when explicit operator permission is granted.
# Leave UNCONFIGURED to enforce ToS compliance (displays official web link instead of scraping).
JR_TRAINFORMATION_PROXY_URL=JR_TRAINFORMATION_PROXY_URL_UNCONFIGURED

# JR_SHIKOKU_PROXY_URL: Optional authorized proxy/gateway base URL (https://...) for
# JR Shikoku feeds when explicit operator permission is granted.
# Leave UNCONFIGURED to enforce ToS compliance (displays official web link instead of scraping).
JR_SHIKOKU_PROXY_URL=JR_SHIKOKU_PROXY_URL_UNCONFIGURED

